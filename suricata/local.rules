# Port Scan Detection
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Nmap Port Scan"; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; sid:1000001; rev:1;)

# SSH Brute Force
alert tcp any any -> $HOME_NET 22 (msg:"ET BRUTE SSH Brute Force"; flow:to_server; threshold: type threshold, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# ICMP Flood
alert icmp any any -> $HOME_NET any (msg:"ET SCAN ICMP Flood"; threshold: type threshold, track by_src, count 10, seconds 5; sid:1000003; rev:1;)

# Metasploit Port 4444
alert tcp $HOME_NET any -> any 4444 (msg:"ET MALWARE Metasploit Payload"; sid:1000004; rev:1;)

# Telnet Attempt
alert tcp any any -> $HOME_NET 23 (msg:"ET SCAN Telnet Attempt"; sid:1000005; rev:1;)

# SQL Injection
alert http any any -> $HOME_NET any (msg:"ET WEB SQL Injection"; content:"union select"; nocase; sid:1000006; rev:1;)

# XSS Attempt
alert http any any -> $HOME_NET any (msg:"ET WEB XSS Attempt"; content:"<script>"; nocase; sid:1000007; rev:1;)

# Large Upload Exfil
alert http $HOME_NET any -> any any (msg:"ET EXFIL Large HTTP Upload"; dsize:>10000; sid:1000008; rev:1;)
